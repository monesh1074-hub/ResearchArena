{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd contention-guard/client && npm install",
  "buildCommand": "cd contention-guard/client && npm run build",
  "outputDirectory": "contention-guard/client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
