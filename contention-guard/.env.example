# Server Port
PORT=4000
HOST=0.0.0.0

# Database Configuration
# Set DB_MODE to 'postgres' to connect to PostgreSQL, or 'memory' for in-memory simulation mode
# If 'postgres' is chosen and connection fails, server automatically falls back to in-memory mode
DB_MODE=memory

# PostgreSQL Connection (used if DB_MODE=postgres)
PGHOST=localhost
PGPORT=5432
PGDATABASE=contention_guard
PGUSER=postgres
PGPASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contention_guard

# Adaptive Controller Configuration
ADAPTIVE_WINDOW_SIZE=50
ADAPTIVE_HIGH_THRESHOLD=0.40
ADAPTIVE_LOW_THRESHOLD=0.15
ADAPTIVE_COOLDOWN_TRANSACTIONS=10
ADAPTIVE_COOLDOWN_MS=2000

# OCC Configuration
OCC_MAX_RETRIES=4
OCC_BASE_BACKOFF_MS=5
OCC_MAX_BACKOFF_MS=100

# PCC Configuration
PCC_LOCK_TIMEOUT_MS=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
