{
  "name": "contention-guard",
  "version": "1.0.0",
  "description": "Contention-Aware Transaction Guard (CTG) - Research Platform & Benchmark Dashboard",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "start": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "concurrency-control",
    "occ",
    "pcc",
    "adaptive-guard",
    "database-transactions"
  ],
  "author": "ContentionGuard Research Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
